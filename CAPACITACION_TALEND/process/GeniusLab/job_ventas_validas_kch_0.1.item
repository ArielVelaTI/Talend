    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="r01_id_valido" expression="row1.pedido_id != null &amp;&amp; !row1.pedido_id.trim().isEmpty()" type="id_Boolean"/>
        <mapperTableEntries name="r02_importe_valido" expression="row1.importe_total != null &amp;&amp; row1.importe_total.compareTo(java.math.BigDecimal.ZERO) >= 0" type="id_Boolean"/>
        <mapperTableEntries name="r03_estado_valido" expression="&quot;CONFIRMADO&quot;.equals(row1.estado_pedido) || &quot;ENTREGADO&quot;.equals(row1.estado_pedido)" type="id_Boolean"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="ventas_validas_kch" expressionFilter="Var.r01_id_valido&#xD;&#xA;&amp;&amp; Var.r02_importe_valido&#xD;&#xA;&amp;&amp; Var.r03_estado_valido" activateExpressionFilter="true">
