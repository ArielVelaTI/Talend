      <indicators xsi:type="dataquality.indicators:UniqueCountIndicator" xmi:id="_GX_UdNF2EfGk7IBz-sW1Kg" count="1000163" computed="true" uniqueValueCount="1043">
        <parameters xmi:id="_GX_UddF2EfGk7IBz-sW1Kg"/>
