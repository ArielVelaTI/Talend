      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_S68wudF0EfGk7IBz-sW1Kg" count="99441" computed="true" distinctValueCount="8">
        <parameters xmi:id="_S68wutF0EfGk7IBz-sW1Kg"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/Fuente_csv/orders_0.1.item#_Nc7O5cwoEfGZzMhpNuWmEw"/>
