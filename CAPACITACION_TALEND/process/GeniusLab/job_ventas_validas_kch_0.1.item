        <mapperTableEntries name="fecha_pedido" expression="row1.fecha_pedido " type="id_Date"/>
        <mapperTableEntries name="estado_pedido" expression="row1.estado_pedido " type="id_String"/>
        <mapperTableEntries name="moneda" expression="row1.moneda " type="id_String"/>
        <mapperTableEntries name="importe_total" expression="row1.importe_total " type="id_BigDecimal"/>
        <mapperTableEntries name="motivo_rechazo" expression="!Var.r01_id_valido ? &quot;DQ-01: Identificador vacio&quot; : !Var.r02_importe_valido ? &quot;DQ-02: Importe invalido&quot; : !Var.r03_estado_valido ? &quot;DQ-03: Estado no permitido para ventas&quot; : &quot;SIN_ERROR&quot;" type="id_String" nullable="true"/>
        <mapperTableEntries name="fecha_rechazo" expression="TalendDate.getCurrentDate()" type="id_Date" nullable="true"/>
        <mapperTableEntries name="load_ts" expression="TalendDate.getCurrentDate()" type="id_Date" nullable="true"/>
        <mapperTableEntries name="load_source" expression="context.LOAD_SOURCE_TAG" type="id_String" nullable="true"/>
      </outputTables>
