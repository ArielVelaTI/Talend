      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_NzG3pNF1EfGk7IBz-sW1Kg" count="99441" computed="true" distinctValueCount="14994">
        <parameters xmi:id="_NzG3pdF1EfGk7IBz-sW1Kg"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/Fuente_csv/customers_0.1.item#_H96NBcweEfGZzMhpNuWmEw"/>
