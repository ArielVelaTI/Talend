      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_S67ihNF0EfGk7IBz-sW1Kg" count="99441" computed="true" distinctValueCount="99441">
        <parameters xmi:id="_S67ihdF0EfGk7IBz-sW1Kg"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/Fuente_csv/orders_0.1.item#_Nc7O48woEfGZzMhpNuWmEw"/>
