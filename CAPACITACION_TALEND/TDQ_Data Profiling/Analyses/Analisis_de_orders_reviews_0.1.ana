          <taggedValue xmi:id="_mjzCstF4EfGk7IBz-sW1Kg" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_mjzCs9F4EfGk7IBz-sW1Kg" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_lgxfwNF4EfGk7IBz-sW1Kg" count="1" computed="true">
        <parameters xmi:id="_lgxfwdF4EfGk7IBz-sW1Kg"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/Fuente_csv/olist_order_reviews_dataset_0.1.item#_ok6ktNFeEfG9y9uSWbWHWw"/>
