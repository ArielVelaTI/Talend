      <indicators xsi:type="dataquality.indicators:MaxLengthIndicator" xmi:id="_MAkw_9GfEfGAIvdQgkCceQ" count="3095" computed="true" length="34">
        <parameters xmi:id="_MAkxANGfEfGAIvdQgkCceQ">
