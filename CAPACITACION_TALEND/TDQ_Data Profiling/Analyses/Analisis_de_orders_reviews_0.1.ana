        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Row_Count_0.1.definition#_ccFOkBF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_mn0nENF4EfGk7IBz-sW1Kg" name="Row Count" label="Row Count">
          <taggedValue xmi:id="_mn0nEdF4EfGk7IBz-sW1Kg" tag="Description" value="counts the number of rows"/>
          <taggedValue xmi:id="_mn0nEtF4EfGk7IBz-sW1Kg" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_mn0nE9F4EfGk7IBz-sW1Kg" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_lgyGgtF4EfGk7IBz-sW1Kg" computed="true">
