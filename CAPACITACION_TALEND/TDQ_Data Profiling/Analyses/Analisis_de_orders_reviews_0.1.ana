        <builtInIndicatorDefinition xmi:id="_mkCTQNF4EfGk7IBz-sW1Kg" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_mkCTQdF4EfGk7IBz-sW1Kg" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_mkCTQtF4EfGk7IBz-sW1Kg" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_mkCTQ9F4EfGk7IBz-sW1Kg" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
