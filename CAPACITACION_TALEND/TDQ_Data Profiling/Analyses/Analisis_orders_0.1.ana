        <builtInIndicatorDefinition xmi:id="_VWtocNF0EfGk7IBz-sW1Kg" name="Distinct Count" label="Distinct Count">
          <taggedValue xmi:id="_VWtocdF0EfGk7IBz-sW1Kg" tag="Description" value="counts the number of distinct rows (like a &quot;SELECT DISTINCT&quot; SQL statement)"/>
          <taggedValue xmi:id="_VWtoctF0EfGk7IBz-sW1Kg" tag="Purpose" value="evaluates the number of distinct records"/>
          <sqlGenericExpression xmi:id="_VWtoc9F0EfGk7IBz-sW1Kg" body="SELECT COUNT(*) FROM (SELECT DISTINCT &lt;%=__COLUMN_NAMES__%> FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>) A" language="SQL"/>
