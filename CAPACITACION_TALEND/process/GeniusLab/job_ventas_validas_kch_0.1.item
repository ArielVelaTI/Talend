        <mapperTableEntries name="load_source" expression="context.LOAD_SOURCE_TAG" type="id_String" nullable="true"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="row_rechazos" activateCondensedTool="true" reject="true">
