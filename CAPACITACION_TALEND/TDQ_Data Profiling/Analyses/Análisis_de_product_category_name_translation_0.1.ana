          <taggedValue xmi:id="_wmOfMtGfEfGAIvdQgkCceQ" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_wmOfM9GfEfGAIvdQgkCceQ" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
