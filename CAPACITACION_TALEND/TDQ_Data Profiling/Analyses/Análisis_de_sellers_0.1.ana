        <builtInIndicatorDefinition xmi:id="_Mv3f4NGfEfGAIvdQgkCceQ" name="Distinct Count" label="Distinct Count">
          <taggedValue xmi:id="_Mv3f4dGfEfGAIvdQgkCceQ" tag="Description" value="counts the number of distinct rows (like a &quot;SELECT DISTINCT&quot; SQL statement)"/>
          <taggedValue xmi:id="_Mv3f4tGfEfGAIvdQgkCceQ" tag="Purpose" value="evaluates the number of distinct records"/>
          <sqlGenericExpression xmi:id="_Mv3f49GfEfGAIvdQgkCceQ" body="SELECT COUNT(*) FROM (SELECT DISTINCT &lt;%=__COLUMN_NAMES__%> FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>) A" language="SQL"/>
