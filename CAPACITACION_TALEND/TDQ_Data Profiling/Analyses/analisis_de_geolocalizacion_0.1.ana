      <indicators xsi:type="dataquality.indicators:MaxLengthIndicator" xmi:id="_GX_UfdF2EfGk7IBz-sW1Kg" count="1000163" computed="true" length="7">
        <parameters xmi:id="_GX_UftF2EfGk7IBz-sW1Kg">
          <textParameter xmi:id="_GX_Uf9F2EfGk7IBz-sW1Kg" useBlank="false"/>
