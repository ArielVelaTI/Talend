      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_NzGQlNF1EfGk7IBz-sW1Kg" count="99441" computed="true" distinctValueCount="99441">
        <parameters xmi:id="_NzGQldF1EfGk7IBz-sW1Kg"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/Fuente_csv/customers_0.1.item#_H96NA8weEfGZzMhpNuWmEw"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Distinct_Count_0.1.definition#_ccHq0BF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_Oi5WHdF1EfGk7IBz-sW1Kg" name="Distinct Count" label="Distinct Count">
          <taggedValue xmi:id="_Oi5WHtF1EfGk7IBz-sW1Kg" tag="Description" value="counts the number of distinct rows (like a &quot;SELECT DISTINCT&quot; SQL statement)"/>
          <taggedValue xmi:id="_Oi5WH9F1EfGk7IBz-sW1Kg" tag="Purpose" value="evaluates the number of distinct records"/>
          <sqlGenericExpression xmi:id="_Oi5WINF1EfGk7IBz-sW1Kg" body="SELECT COUNT(*) FROM (SELECT DISTINCT &lt;%=__COLUMN_NAMES__%> FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>) A" language="SQL"/>
        </builtInIndicatorDefinition>
