        <builtInIndicatorDefinition xmi:id="_M0s8kNGfEfGAIvdQgkCceQ" name="Distinct Count" label="Distinct Count">
          <taggedValue xmi:id="_M0s8kdGfEfGAIvdQgkCceQ" tag="Description" value="counts the number of distinct rows (like a &quot;SELECT DISTINCT&quot; SQL statement)"/>
          <taggedValue xmi:id="_M0s8ktGfEfGAIvdQgkCceQ" tag="Purpose" value="evaluates the number of distinct records"/>
          <sqlGenericExpression xmi:id="_M0s8k9GfEfGAIvdQgkCceQ" body="SELECT COUNT(*) FROM (SELECT DISTINCT &lt;%=__COLUMN_NAMES__%> FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>) A" language="SQL"/>
