      <indicators xsi:type="dataquality.indicators:UniqueCountIndicator" xmi:id="_MAkxMNGfEfGAIvdQgkCceQ" count="3095" computed="true" uniqueValueCount="7">
        <parameters xmi:id="_MAkxMdGfEfGAIvdQgkCceQ"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/Fuente_csv/sellers_dataset_0.1.item#_K2DSptFfEfG9y9uSWbWHWw"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Unique_Count_0.1.definition#_ccHq0RF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_M3JMkNGfEfGAIvdQgkCceQ" name="Unique Count" label="Unique Count">
          <taggedValue xmi:id="_M3JMkdGfEfGAIvdQgkCceQ" tag="Description" value="counts the number of unique rows (i.e. distinct rows with only one instance: rows that are not duplicated)"/>
          <taggedValue xmi:id="_M3JMktGfEfGAIvdQgkCceQ" tag="Purpose" value="evaluates the number of unique records"/>
