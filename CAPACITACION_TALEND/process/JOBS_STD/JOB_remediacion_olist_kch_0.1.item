    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;UPDATE DSADEV.olist_orders_cuarentena_kch c&#xD;&#xA;INNER JOIN DSADEV.olist_orders_gold_kch g&#xD;&#xA;ON c.order_id = g.order_id&#xD;&#xA;SET c.estado_remediacion = 'RESUELTO',&#xD;&#xA;c.fecha_remediacion = NOW()&#xD;&#xA;WHERE c.estado_remediacion = 'CORREGIDO'&#xD;&#xA;AND c.fecha_entrega_corregida IS NOT NULL&#xD;&#xA;AND g.order_delivered_customer_date = c.fecha_entrega_corregida&#xD;&#xA;AND g.customer_id = c.customer_id&#xD;&#xA;AND g.order_status = c.order_status;&quot;"/>
