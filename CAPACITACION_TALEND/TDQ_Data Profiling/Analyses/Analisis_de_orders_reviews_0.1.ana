          <taggedValue xmi:id="_mmDsgtF4EfGk7IBz-sW1Kg" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_mmDsg9F4EfGk7IBz-sW1Kg" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
