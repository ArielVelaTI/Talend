          <taggedValue xmi:id="_mUSnEdF4EfGk7IBz-sW1Kg" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_mUSnEtF4EfGk7IBz-sW1Kg" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_mUSnE9F4EfGk7IBz-sW1Kg" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
